digraph "apb_spi_core" {
label="apb_spi_core";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="rx_valid", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="write_en", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="rx_data", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="tx_data", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="spi_ss_n", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="spi_miso", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="spi_mosi", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="spi_sclk", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="pready", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="prdata", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="pwdata", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="pwrite", color="black", fontcolor="black" ];
n13 [ shape=octagon, label="penable", color="black", fontcolor="black" ];
n14 [ shape=octagon, label="psel", color="black", fontcolor="black" ];
n15 [ shape=octagon, label="paddr", color="black", fontcolor="black" ];
n16 [ shape=octagon, label="rst_n", color="black", fontcolor="black" ];
n17 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c18 [ shape=record, label="{{<p17> clk|<p16> rst_n|<p6> spi_miso|<p4> tx_data|<p2> write_en}|u_spi\nspi_ctrl_fsm|{<p3> rx_data|<p1> rx_valid|<p7> spi_mosi|<p8> spi_sclk|<p5> spi_ss_n}}",  ];
c19 [ shape=record, label="{{<p17> clk|<p15> paddr|<p13> penable|<p14> psel|<p11> pwdata|<p12> pwrite|<p16> rst_n|<p3> rx_data|<p1> rx_valid}|u_apb\napb_interface|{<p10> prdata|<p9> pready|<p4> tx_data|<p2> write_en}}",  ];
c18:p1:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c19:p1:w [color="black", fontcolor="black", label=""];
c19:p10:e -> n10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n11:e -> c19:p11:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n12:e -> c19:p12:w [color="black", fontcolor="black", label=""];
n13:e -> c19:p13:w [color="black", fontcolor="black", label=""];
n14:e -> c19:p14:w [color="black", fontcolor="black", label=""];
n15:e -> c19:p15:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n16:e -> c18:p16:w [color="black", fontcolor="black", label=""];
n16:e -> c19:p16:w [color="black", fontcolor="black", label=""];
n17:e -> c18:p17:w [color="black", fontcolor="black", label=""];
n17:e -> c19:p17:w [color="black", fontcolor="black", label=""];
c19:p2:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c18:p2:w [color="black", fontcolor="black", label=""];
c18:p3:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c19:p3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p4:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c18:p4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c18:p5:e -> n5:w [color="black", fontcolor="black", label=""];
n6:e -> c18:p6:w [color="black", fontcolor="black", label=""];
c18:p7:e -> n7:w [color="black", fontcolor="black", label=""];
c18:p8:e -> n8:w [color="black", fontcolor="black", label=""];
c19:p9:e -> n9:w [color="black", fontcolor="black", label=""];
}
