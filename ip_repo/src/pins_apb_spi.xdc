# System Clock (100 MHz target)
create_clock -period 10.000 -name sys_clk [get_ports clk]

# System Reset
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports rst_n]

# SPI Interface Signals
set_property -dict {PACKAGE_PIN J2 IOSTANDARD LVCMOS33} [get_ports spi_miso]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33} [get_ports spi_ss_n]

set_property PACKAGE_PIN A14 [get_ports {paddr[31]}]
set_property PACKAGE_PIN B18 [get_ports {paddr[30]}]
set_property PACKAGE_PIN A18 [get_ports {paddr[29]}]
set_property PACKAGE_PIN E15 [get_ports {paddr[28]}]
set_property PACKAGE_PIN E16 [get_ports {paddr[27]}]
set_property PACKAGE_PIN D15 [get_ports {paddr[26]}]
set_property PACKAGE_PIN C15 [get_ports {paddr[25]}]
set_property PACKAGE_PIN H16 [get_ports {paddr[24]}]
set_property PACKAGE_PIN G16 [get_ports {paddr[23]}]
set_property PACKAGE_PIN F15 [get_ports {paddr[22]}]
set_property PACKAGE_PIN F16 [get_ports {paddr[21]}]
set_property PACKAGE_PIN H14 [get_ports {paddr[20]}]
set_property PACKAGE_PIN G14 [get_ports {paddr[19]}]
set_property PACKAGE_PIN E17 [get_ports {paddr[18]}]
set_property PACKAGE_PIN D17 [get_ports {paddr[17]}]
set_property PACKAGE_PIN K13 [get_ports {paddr[16]}]
set_property PACKAGE_PIN J13 [get_ports {paddr[15]}]
set_property PACKAGE_PIN H17 [get_ports {paddr[14]}]
set_property PACKAGE_PIN G17 [get_ports {paddr[13]}]
set_property PACKAGE_PIN J14 [get_ports {paddr[12]}]
set_property PACKAGE_PIN H15 [get_ports {paddr[11]}]
set_property PACKAGE_PIN C16 [get_ports {paddr[10]}]
set_property PACKAGE_PIN C17 [get_ports {paddr[9]}]
set_property PACKAGE_PIN E18 [get_ports {paddr[8]}]
set_property PACKAGE_PIN D18 [get_ports {paddr[7]}]
set_property PACKAGE_PIN G18 [get_ports {paddr[6]}]
set_property PACKAGE_PIN F18 [get_ports {paddr[5]}]
set_property PACKAGE_PIN J17 [get_ports {paddr[4]}]
set_property PACKAGE_PIN J18 [get_ports {paddr[3]}]
set_property PACKAGE_PIN K15 [get_ports {paddr[2]}]
set_property PACKAGE_PIN J15 [get_ports {paddr[1]}]
set_property PACKAGE_PIN K16 [get_ports {paddr[0]}]
set_property PACKAGE_PIN V9 [get_ports {pwdata[7]}]
set_property PACKAGE_PIN U7 [get_ports {pwdata[6]}]
set_property PACKAGE_PIN U6 [get_ports {pwdata[5]}]
set_property PACKAGE_PIN R7 [get_ports {pwdata[4]}]
set_property PACKAGE_PIN T6 [get_ports {pwdata[3]}]
set_property PACKAGE_PIN R8 [get_ports {pwdata[2]}]
set_property PACKAGE_PIN T8 [get_ports {pwdata[1]}]
set_property PACKAGE_PIN U8 [get_ports {pwdata[0]}]
